{
  "name": "slidev-theme-bluehands-slidev-theme",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@iconify-json/streamline-freehand": "^1.2.1",
    "@slidev/types": "^52.12.0",
    "playwright-chromium": "^1.58.2",
    "slidev-component-pager": "^1.1.0",
    "unocss": "^66.6.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.12.0"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "Nunito Sans",
        "mono": "Fira Code"
      }
    }
  }
}
