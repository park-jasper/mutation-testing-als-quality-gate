{
  "stryker-config": {
    "concurrency": 8,
    "mutation-level": "Standard",
    "language-version": "latest",
    "additional-timeout": 10000,
    "timeout-ratio": 2,
    "mutate": [
      "**/*"
    ],
    "project-info": {
      "name": "github.com/park-jasper/mutation-testing-als-quality-gate",
      "module": "QuickSort"
    },
    "solution": null,
    "configuration": null,
    "target-framework": null,
    "project": "UserCode.csproj",
    "coverage-analysis": "perTest",
    "disable-bail": false,
    "disable-mix-mutants": false,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "verbosity": "info",
    "reporters": [
      "Progress",
      "Html"
    ],
    "since": {
      "enabled": false,
      "ignore-changes-in": [],
      "target": "master"
    },
    "baseline": {
      "enabled": false,
      "provider": "dashboard",
      "azure-fileshare-url": "",
      "s3-bucket-name": "",
      "s3-endpoint": "",
      "s3-region": "",
      "fallback-version": "master"
    },
    "dashboard-url": "https://dashboard.stryker-mutator.io",
    "test-projects": [],
    "test-case-filter": "QuickSortTests3",
    "test-runner": null,
    "ignore-mutations": [],
    "ignore-methods": [],
    "report-file-name": "mutation-report",
    "break-on-initial-test-failure": false
  }
}